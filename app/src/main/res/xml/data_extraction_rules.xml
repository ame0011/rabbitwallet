<!--
  Backup and device transfer rules for Android 12 (API 31) and later.
  The database contains personal financial data, so the cloud backup is
  performed only when the client side encryption is available, exactly as
  configured in backup_rules.xml for the previous releases.
  -->
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="root"
            path="."
            requireFlags="clientSideEncryption" />
    </cloud-backup>
    <device-transfer>
        <include
            domain="root"
            path="." />
    </device-transfer>
</data-extraction-rules>
